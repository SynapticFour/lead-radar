# GitHub — required for code search (/search/code has no anonymous tier).
# Prefer a classic PAT with public_repo, or fine-grained read on public repos.
# After: gh auth login -h github.com
#   ./scripts/set-github-token.sh
GITHUB_TOKEN=

# Optional alias used by Actions secret LEAD_RADAR_GITHUB_TOKEN
# LEAD_RADAR_GITHUB_TOKEN=

# Reddit script app (https://www.reddit.com/prefs/apps) — optional but recommended
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: Claude Haiku triage pass on digest items
ANTHROPIC_API_KEY=

# Optional: Slack or Discord webhook for top-5 alerts
WEBHOOK_URL=

# Shown in User-Agent header on all requests
CONTACT_EMAIL=contact@synapticfour.com
